+/// `HH:MM` in the `$WORKLOG_TZ` offset, [`FILL_IN`] when empty, verbatim when unparseable.
+fn time_or_fill_in(t: &str) -> String {
+    if t.is_empty() {
+        return FILL_IN.to_owned();
+    }
+    match chrono::DateTime::parse_from_rfc3339(t) {
+        Ok(d) => d
