@@ -230,20 +254,42 @@ pub(crate) fn derive_github_url(remote_url: &str, sha: &str) -> Option<String> {
     if owner.is_empty() || repo.is_empty() {
         return None;
     }
     Some(format!("https://github.com/{owner}/{repo}/commit/{sha}"))
 }
 
