+fn init_git_repo(path: &Path, branch: &str) {
+    let out = Command::new("git")
+        .arg("-C")
+        .arg(path)
+        .args(["init", "-q", "-b", branch])
+        .output()
+        .unwrap();
+    assert!(
+        out.status.success(),
+        "git init failed: {}",
+        String::from_utf8_lossy(&out.stderr)
+    );
+}
