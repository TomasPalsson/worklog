+        folders: vec![],
+    };
+    assert_eq!(reg.customer_named("sjúkra"), Some("Sjúkra".into()));
+    assert_eq!(reg.customer_named("SJÚKRA"), Some("Sjúkra".into()));
+    assert_eq!(
+        reg.customer_named("sjukratryggingar"),
+        Some("Sjúkra".into())
