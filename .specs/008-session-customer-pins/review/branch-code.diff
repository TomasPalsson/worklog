+#[test]
+fn customer_named_matches_name_or_alias_case_insensitively() {
+    let reg = Registry {
+        customers: vec![Customer {
+            id: None,
+            name: "Sjúkra".into(),
+            aliases: vec!["Sjukratryggingar".into()],
